{
 "elemod": 2,
 "id": "core",
 "version": "1.1",
 "title": "core",
 "description": "The boot copier and the hook bus for the Digitakt II: every other mod needs it. From 1.1 also each frame's per-track parameter values before the stock modulators (ev_frame_params), the key-LED frame before the stock views (ev_key_leds), the mods' project data and kit data, saved and loaded with the project and its kits and copied with the kits (core_projdata, core_kitdata), and value rows for PERSONALIZE and SETTINGS (core_addvalue). On its own it changes nothing the unit does.",
 "category": "Framework",
 "author": "irpina",
 "license": "GPL-2.0-or-later",
 "target": {
  "device": "digitakt-mk2",
  "product": "Digitakt II",
  "os": "1.17",
  "syx_sha256": "26c22f6652625ac2cfd47f7ee970d388ed8b6427dae3563c0a6a2f2d334350d5",
